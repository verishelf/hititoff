{
  "expo": {
    "name": "HitItOff",
    "slug": "hititoff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "hititoff",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#9d1b6b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luvii.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HitItOff uses your location to find compatible matches within your selected radius.",
        "NSPhotoLibraryUsageDescription": "HitItOff needs access to your photos and videos to upload profile pictures and video intros.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.luvii.app",
      "adaptiveIcon": {
        "backgroundColor": "#9d1b6b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#9d1b6b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HitItOff uses your location to find compatible matches within your selected radius."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HitItOff needs access to your photos and videos to upload profile pictures and video intros."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-video",
      "expo-font",
      "expo-audio",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "4c4611f6-8e73-4119-84e4-1291a9d3435a"
      }
    },
    "owner": "mrposada"
  }
}
