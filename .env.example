EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — use platform-specific keys in builds (required for iOS/Android)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
# Optional: override RevenueCat offering identifier (default: flikr-pro)
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=flikr-pro
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxx/ios-banner
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxx/android-banner
EXPO_PUBLIC_OPENAI_API_KEY=sk-xxx

# Supabase Edge Function secrets (set via: supabase secrets set ...)
# OPENAI_API_KEY=sk-xxx
# GOOGLE_PLACES_API_KEY=xxx
# VERIFICATION_WEBHOOK_SECRET=xxx

# Marketing site — set when App Store / Play Store listings are live
# NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.luvii.app
